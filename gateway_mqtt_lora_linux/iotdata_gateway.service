[Unit]
Description=iotdata Lora (EBYTE E22-900T22U) to MQTT Gateway Service
Wants=network-online.target
After=network-online.target
After=dev-e22900t22u.device
BindsTo=dev-e22900t22u.device

[Service]
Type=simple
ExecStart=/usr/local/bin/iotdata-gateway --config /etc/default/iotdata-gateway
TimeoutStopSec=15s
KillMode=mixed
# always, not on-failure: a REBOOT command stops the process CLEANLY, and on-failure would leave
# it stopped -- the one case where the restart matters most. A deliberate `systemctl stop` is
# unaffected, since Restart= only covers the process exiting on its own.
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
WantedBy=dev-e22900t22u.device
