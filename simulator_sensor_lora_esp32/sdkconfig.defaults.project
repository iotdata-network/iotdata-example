# 4 MB flash with a custom partition map: dual-OTA + storage + a dedicated `diag` partition 
# for the blackbox recorder's ESP_FLASH backend (BLACKBOX_ENABLE=2). `diag` is always present,
# so changing the recorder mode never needs the partition table reflashed.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
